  command: grep -q 'HARBOR_KHOJ_VERSION="2.0.0-beta.28"' profiles/default.env
  tags: [spec, khoj-llamacpp, implemented]
  id: m9n

## llamaswap
- label: llamaswap default config points -m at /app/.cache/llama.cpp (the compose mount), not /root/.cache
