# Rapid-MLX host runner and Harbor proxy
HARBOR_RAPIDMLX_HOST_PORT=34991
HARBOR_RAPIDMLX_IMAGE="caddy"
HARBOR_RAPIDMLX_VERSION="2-alpine"
HARBOR_RAPIDMLX_WORKSPACE="./services/rapidmlx"
HARBOR_RAPIDMLX_UPSTREAM_URL="http://host.docker.internal:8000"
HARBOR_RAPIDMLX_RUNNER_PORT=8000
HARBOR_RAPIDMLX_MODEL="mlx-community/Qwen3.5-4B-MLX-4bit"
HARBOR_RAPIDMLX_HF_PATH="mlx-community/Qwen3.5-4B-MLX-4bit"
HARBOR_RAPIDMLX_API_KEY="not-needed"
HARBOR_RAPIDMLX_MANAGE_HOST=true
HARBOR_RAPIDMLX_VOLUMES=""
HARBOR_BIFROST_RAPIDMLX_BASE_URL="http://rapidmlx:8080"
HARBOR_BIFROST_RAPIDMLX_API_KEY="not-needed"
HARBOR_BIFROST_RAPIDMLX_MODELS="*"
