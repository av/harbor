# DB-backed LobeHub; the existing lobechat service keeps browser-local storage.
HARBOR_LOBEHUB_HOST_PORT=34960
HARBOR_LOBEHUB_S3_HOST_PORT=34961
HARBOR_LOBEHUB_BIND_HOST=127.0.0.1
HARBOR_LOBEHUB_PUBLIC_HOST=localhost
HARBOR_LOBEHUB_IMAGE="lobehub/lobehub"
HARBOR_LOBEHUB_VERSION="latest"
HARBOR_LOBEHUB_DB_IMAGE="paradedb/paradedb"
HARBOR_LOBEHUB_DB_VERSION="latest-pg17"
HARBOR_LOBEHUB_REDIS_IMAGE="redis"
HARBOR_LOBEHUB_REDIS_VERSION="7-alpine"
HARBOR_LOBEHUB_S3_IMAGE="rustfs/rustfs"
HARBOR_LOBEHUB_S3_VERSION="latest"
HARBOR_LOBEHUB_S3_INIT_IMAGE="rustfs/rc"
HARBOR_LOBEHUB_S3_INIT_VERSION="latest"
HARBOR_LOBEHUB_AUTH_SECRET=""
HARBOR_LOBEHUB_KEY_VAULTS_SECRET=""
HARBOR_LOBEHUB_JWKS_KEY_B64=""
HARBOR_LOBEHUB_DB_PASSWORD=""
HARBOR_LOBEHUB_S3_ACCESS_KEY="lobehub"
HARBOR_LOBEHUB_S3_SECRET_KEY=""
HARBOR_LOBEHUB_ALLOWED_EMAILS=""
HARBOR_LOBEHUB_EMBEDDING_MODEL="mxbai-embed-large:latest"
HARBOR_LOBEHUB_CHAT_MODEL="qwen3:4b"
