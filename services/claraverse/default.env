# ClaraVerse
HARBOR_CLARAVERSE_IMAGE="ghcr.io/claraverse-space/claraverse"
HARBOR_CLARAVERSE_VERSION="latest"
HARBOR_CLARAVERSE_MYSQL_IMAGE="mysql"
HARBOR_CLARAVERSE_MYSQL_VERSION="8.0"
HARBOR_CLARAVERSE_MONGODB_IMAGE="mongo"
HARBOR_CLARAVERSE_MONGODB_VERSION="7"
HARBOR_CLARAVERSE_REDIS_IMAGE="redis"
HARBOR_CLARAVERSE_REDIS_VERSION="7-alpine"
HARBOR_CLARAVERSE_BIND_HOST="127.0.0.1"
HARBOR_CLARAVERSE_HOST_PORT=34970
HARBOR_CLARAVERSE_WORKSPACE="./services/claraverse"
HARBOR_CLARAVERSE_ALLOWED_ORIGINS="http://localhost:34970,http://127.0.0.1:34970"
