# Optional AutoGPT Platform settings.
#
# Harbor exposes the common settings through `harbor config`. Use
# `harbor env autogpt VARIABLE value` for advanced AutoGPT-only settings.
# See the AutoGPT service guide for remote, Ollama, and custom endpoint examples.

# Reuse Harbor's shared provider keys by default. `harbor env autogpt ...` edits
# this file, so an AutoGPT-specific literal value still takes precedence.
OPEN_ROUTER_API_KEY=${HARBOR_OPENROUTER_KEY:-}
CHAT_OPENAI_API_KEY=${HARBOR_OPENAI_KEY:-}
ANTHROPIC_API_KEY=${HARBOR_ANTHROPIC_KEY:-}
GROQ_API_KEY=${HARBOR_GROQ_KEY:-}

# A custom OpenAI-compatible endpoint must serve both the chat model and the
# Graphiti embedding model from the same base URL.
# CHAT_USE_LOCAL=true
# CHAT_BASE_URL=http://host.docker.internal:11434/v1
# CHAT_API_KEY=local
# CHAT_FAST_STANDARD_MODEL=qwen3.5:4b
# GRAPHITI_LLM_MODEL=qwen3.5:4b
# GRAPHITI_RERANKER_MODEL=qwen3.5:4b
# GRAPHITI_EMBEDDER_MODEL=nomic-embed-text

# Do not set STORE_EMBEDDING_MODEL to nomic-embed-text. AutoGPT's unified-search
# database requires exactly 1536 dimensions; nomic-embed-text emits 768. A
# fresh pure-Ollama install therefore cannot populate the global search index
# and logs non-fatal indexer retries. See the service guide for the precise
# search impact and the 1536-dimensional gateway requirement.
