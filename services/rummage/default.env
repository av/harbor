# rummage
HARBOR_RUMMAGE_HOST_PORT=35100
HARBOR_RUMMAGE_IMAGE="ghcr.io/av/rummage"
# Image tags are <version>-<backend>; the backend suffix comes from the
# capability (cpu by default, cuda with nvidia, see AMD_BACKEND for rocm)
HARBOR_RUMMAGE_VERSION="latest"
HARBOR_RUMMAGE_WORKSPACE="./services/rummage"
# Host folder mounted read-only at /folders; add it (or sub-folders) in the UI
HARBOR_RUMMAGE_FOLDERS="./services/rummage/folders"
# Image used with the rocm capability: "vulkan" or "rocm"
HARBOR_RUMMAGE_AMD_BACKEND="vulkan"
# Container group for GPU device access with the rocm capability; a name from
# the image's /etc/group or a numeric host gid (e.g. the host "render" group)
HARBOR_RUMMAGE_GPU_GROUP="video"
